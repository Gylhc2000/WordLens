<Window x:Class="WordLens.Windows.LensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WordLens.Windows"
        Title="WordLens"
        Width="220" Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Background="Transparent"
        x:Name="Root">
    <Grid>
        <local:MagnifierHost x:Name="Magnifier" Width="220" Height="220" />
    </Grid>
</Window>
