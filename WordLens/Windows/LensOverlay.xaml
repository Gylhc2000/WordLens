<Window x:Class="WordLens.Windows.LensOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordLensOverlay"
        Width="220" Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Background="Transparent">
    <!-- Thin ring + faint glass tint + tiny center crosshair, drawn above the magnifier
         (separate window to avoid HwndHost airspace issues). -->
    <Border Width="220" Height="220" CornerRadius="110"
            BorderBrush="#5B7C4B" BorderThickness="2"
            Background="#0E2A12" Opacity="0.12">
        <Canvas>
            <Line X1="110" Y1="106" X2="110" Y2="114" Stroke="#3C5A2C" StrokeThickness="1.5" />
            <Line X1="106" Y1="110" X2="114" Y2="110" Stroke="#3C5A2C" StrokeThickness="1.5" />
        </Canvas>
    </Border>
</Window>
